# Project metadata
PROJECT_NAME=Backend API
VERSION=1.0.0
DESCRIPTION=FastAPI backend with clean architecture

# API configuration
API_V1_STR=/api/v1

# Server configuration
HOST=0.0.0.0
PORT=7878
RELOAD=True

# Database configuration
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_DB=appdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://appuser:apppassword@localhost:5432/appdb

# JWT configuration
JWT_SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
PASSWORD_HASH_SCHEMES=bcrypt
 
# CORS configuration
# Use '*' to allow all origins (no credentials), or provide a comma-separated list for whitelisting with credentials
# Example: ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=*
